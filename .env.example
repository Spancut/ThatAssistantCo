# Public — safe to expose to the browser. RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never import from a "use client" file. Used by scripts/seed.ts
# and any future server-only admin operation.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Milestone 3+ (AI Workbench). Server-only.
OPENAI_API_KEY=

# Playwright only, never used by the app itself. A real inbox you (or your
# team) own — seeded demo accounts and throwaway e2e test users are created
# as +alias addresses under this base (e.g. you+seed-partner@yourdomain.com),
# so if Supabase ever actually attempts to send mail to one, it lands
# somewhere real instead of bouncing. See docs/decisions.md. Falls back to a
# non-deliverable placeholder if unset (fine for CI, where nothing is
# expected to reach Supabase's real signup-email path anyway).
E2E_TEST_EMAIL_BASE=you@yourdomain.com
